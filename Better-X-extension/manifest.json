{
  "manifest_version": 3,
  "name": "Better-X",
  "version": "0.1.71",
  "description": "X 平台增强工具箱：长文大纲、隐藏「有什么新鲜事」、左导航折叠 + 正文加宽，更多能力持续加入。",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}